
@* App #1 - Atlas TaskFlow - Projects Page *@ @model List<Atlas_TaskFlow_App.Models.Project> @ {
    Layout = "_AppLayout";
    ViewData ["Title"] = "Projects";
    int total = ViewBag.TotalProjects;
    int active = ViewBag.ActiveProjects;
    int totalTasks = ViewBag.TotalTasks;
    int completedTasks = ViewBag.CompletedTasks;
    string search = ViewBag.Search ?? "";
    string status = ViewBag.Status ?? "";
    string ? message = TempData["ProjectMessage"] as string;
    string ? error = TempData["ProjectError"] as string;
}

@section Styles {
    <link rel="stylesheet" href="~/css/projects.css" />
}

<div class="projects-page" >

<div class="projects-heading" >
<div >
<h1 > Projects</h1 >
<p > Manage your projects and track their progress.</p >
</div >

<a href="@Url.Action("Create", "Projects")"
class="projects-primary-btn" >
+ New Project
</a >
</div >

@if (message != null) {
    <div class="projects-message success" role="status"> @message </div>
}

@if (error != null) {
    <div class="projects-message error" role="alert"> @error </div>
}

<!-- PROJECT STATISTICS -->
<div class="projects-stats" >

<div class="projects-stat-card" >
<span > Total Projects</span >
<strong > @total</strong >
</div >

<div class="projects-stat-card" >
<span > Active Projects</span >
<strong > @active</strong >
</div >

<div class="projects-stat-card" >
<span > Total Tasks</span >
<strong > @totalTasks</strong >
</div >

<div class="projects-stat-card" >
<span > Completed Tasks</span >
<strong > @completedTasks</strong >
</div >

</div >
<!-- SEARCH AND FILTER -->
<form method="get"
action="@Url.Action("Index", "Projects")"
class="projects-filters" >

<input type="search"
name="search"
value="@search"
placeholder="Search projects..." / >

<select name="status" >
<option value="" > All Statuses</option >

<option value="Planning"
selected="@(status == "Planning")" >
Planning
</option >

<option value="Active"
selected="@(status == "Active")" >
Active
</option >

<option value="On Hold"
selected="@(status == "On Hold")" >
On Hold
</option >

<option value="Completed"
selected="@(status == "Completed")" >
Completed
</option >
</select >

<button type="submit" class="projects-primary-btn" >
Apply
</button >

<a href="@Url.Action("Index", "Projects")"
class="projects-secondary-btn" >
Clear
</a >

</form >
<!-- PROJECT LIST -->
<div class="projects-section-heading" >
<h2 > All Projects</h2 >
<span > @Model.Count project(s) found</span >
</div >

<div class="projects-grid" >

@if (Model.Count == 0) {
    <div class="projects-empty"> <h3>No projects found</h3> <p>Create a project or change your filters.</p> </div>
}

@foreach (var project in Model) {
    int taskCount = project.Tasks.Count;
    int completedCount = project.Tasks .Count(t => t.Status == "Completed");
    int progress = taskCount == 0 ? 0 : (int)Math.Round(completedCount * 100.0 / taskCount);
    string statusClass = project.Status == "Active" ? "active" : project.Status == "Completed" ? "completed" : project.Status == "On Hold" ? "hold" : "planning";

    <article class="projects-card" >

    <div class="projects-card-header" >

    <div class="projects-folder-icon" > 📁</div >

    <span class="projects-status @statusClass" >
    @project.Status
    </span >

    </div >

    <h3 > @project.Name</h3 >

    <p class="projects-description" >
    @(string.IsNullOrWhiteSpace(project.Description)
                        ? "No description added."
                        : project.Description)
    </p >

    <div class="projects-details" >

    <div >
    <span > Tasks</span >
    <strong > @taskCount</strong >
    </div >

    <div >
    <span > Completed</span >
    <strong > @completedCount</strong >
    </div >

    <div >
    <span > Due Date</span >
    <strong >
    @(project.DueDate?.ToString("MMM dd, yyyy")
                                ?? "Not set")
    </strong >
    </div >

    </div >

    <div class="projects-progress-heading" >
    <span > Project Progress</span >
    <strong > @progress%</strong >
    </div >

    <div class="projects-progress-track" >
    <div class="projects-progress-fill"
    style="width:@(progress)%" >
    </div >
    </div >

    <p class="projects-progress-caption" >
    @completedCount of @taskCount tasks completed
    </p >

    <div class="projects-card-actions" >

    <a class="projects-edit-btn"
    href="@Url.Action("Edit", "Projects", new { id = project.ProjectId })" >
    Edit Project
    </a >

    @if (taskCount == 0) {
        <form method="post" action="@Url.Action("Delete", "Projects")" onsubmit="return confirm('Delete this project permanently?');"> @Html.AntiForgeryToken() <input type="hidden" name="id" value="@project.ProjectId" /> <button type="submit" class="projects-delete-btn"> Delete </button> </form>
    }

    else {
        <button type="button" class="projects-delete-btn" disabled title="This project contains tasks"> Delete </button>
    }

    </div> </article>
}

</div >

</div >
