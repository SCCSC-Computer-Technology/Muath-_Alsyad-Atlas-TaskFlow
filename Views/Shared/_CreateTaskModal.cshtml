
@* App #1 - Atlas TaskFlow - Create Task Modal *@
@* Simple MVC MVP - No extra folders or SQL tables *@

@using System
@using System.Linq
@using System.Security.Claims
@using Atlas_TaskFlow_App.Models
@using Microsoft.EntityFrameworkCore

@inject Atlas_TaskFlow_App.Data.TaskFlowDbContext TaskDb

@{
    // Find the currently signed-in user.
    string? userId = User.FindFirst(
        ClaimTypes.NameIdentifier)?.Value;

    // Load only projects belonging to this user.
    // Simple MVP approach to avoid additional files.
    var projects = TaskDb.Projects
        .AsNoTracking()
        .Where(p => p.OwnerUserId == userId)
        .OrderBy(p => p.Name)
        .ToList();

    string? taskError =
        TempData["CreateTaskError"] as string;
}

<dialog id="createTaskDialog" class="create-task-modal">

    <div class="atlas-task-header">
        <h2>Create New Task</h2>

        <p>
            Add your task details, deadline, and checklist.
        </p>
    </div>

    @if (!string.IsNullOrWhiteSpace(taskError))
    {
        <div class="atlas-task-error" role="alert">
            @taskError
        </div>
    }

    @if (projects.Count == 0)
    {
        <div class="atlas-task-warning">
            You need to create a project first.

            <a href="@Url.Action("Create", "Projects")">
                Create Project
            </a>
        </div>
    }

    <!-- REAL TASK FORM -->
    <form id="createTaskForm"
          method="post"
          action="@Url.Action("Create", "Tasks")">

        @Html.AntiForgeryToken()

        <div class="atlas-task-grid">

            <!-- LEFT COLUMN -->
            <div class="atlas-task-column">

                <!-- TITLE -->
                <div class="atlas-task-field">
                    <label for="taskTitle">
                        Task Title *
                    </label>

                    <input id="taskTitle"
                           name="Title"
                           type="text"
                           maxlength="200"
                           placeholder="Enter task title..."
                           required />
                </div>

                <!-- PROJECT -->
                <div class="atlas-task-field">
                    <label for="taskProject">
                        Project *
                    </label>

                    <select id="taskProject"
                            name="ProjectId"
                            required>

                        <option value="">
                            Select a project...
                        </option>

                        @foreach (var project in projects)
                        {
                            <option value="@project.ProjectId">
                                @project.Name
                            </option>
                        }

                    </select>
                </div>

                <!-- DESCRIPTION -->
                <div class="atlas-task-field">
                    <label for="taskDescription">
                        Description
                    </label>

                    <textarea id="taskDescription"
                              name="Description"
                              maxlength="1000"
                              rows="4"
                              placeholder="Describe your task..."></textarea>
                </div>

                <!-- PRIORITY -->
                <fieldset class="atlas-task-priority">

                    <legend>Priority *</legend>

                    <div class="atlas-priority-options">

                        <label>
                            <input type="radio"
                                   name="Priority"
                                   value="Low"
                                   required />
                            <span class="priority-dot low"></span>
                            Low
                        </label>

                        <label>
                            <input type="radio"
                                   name="Priority"
                                   value="Medium" />
                            <span class="priority-dot medium"></span>
                            Medium
                        </label>

                        <label>
                            <input type="radio"
                                   name="Priority"
                                   value="High" />
                            <span class="priority-dot high"></span>
                            High
                        </label>

                        <label>
                            <input type="radio"
                                   name="Priority"
                                   value="Urgent" />
                            <span class="priority-dot urgent"></span>
                            Urgent
                        </label>

                    </div>

                </fieldset>

                <!-- WORKING CHECKLIST -->
                <div class="atlas-task-field">

                    <label for="newSubtask">
                        Checklist / Subtasks
                    </label>

                    <div id="atlasChecklistItems"
                         class="atlas-task-checklist">
                    </div>

                    <div class="atlas-task-add-row">

                        <input id="newSubtask"
                               type="text"
                               maxlength="120"
                               placeholder="Write a subtask..." />

                        <button id="addSubtaskButton"
                                type="button">
                            + Add
                        </button>

                    </div>

                    <small>
                        Checklist items will be saved
                        with the task description.
                    </small>

                </div>

            </div>

            <!-- RIGHT COLUMN -->
            <div class="atlas-task-column">

                <!-- DUE DATE -->
                <div class="atlas-task-field">
                    <label for="taskDueDate">
                        Due Date *
                    </label>

                    <input id="taskDueDate"
                           name="DueDate"
                           type="date"
                           required />
                </div>

                <!-- STATUS -->
                <div class="atlas-task-field">
                    <label for="taskStatus">
                        Status *
                    </label>

                    <select id="taskStatus"
                            name="Status"
                            required>

                        <option value="To Do">
                            To Do
                        </option>

                        <option value="In Progress">
                            In Progress
                        </option>

                        <option value="Completed">
                            Completed
                        </option>

                    </select>
                </div>

                <!-- CURRENT OWNER -->
                <div class="atlas-task-field">
                    <label>Task Owner</label>

                    <div class="atlas-task-readonly">
                        @(User.Identity?.Name ?? "Signed-in user")
                    </div>

                    <small>
                        This task belongs to the selected project
                        and your account.
                    </small>
                </div>

                <!-- INFO -->
                <div class="atlas-task-info">
                    <strong>Task Details</strong>

                    <p>
                        Your task will be saved to SQL Server.
                        You can edit its details later
                        from My Tasks.
                    </p>
                </div>

            </div>

        </div>

        <p id="taskClientError"
           class="atlas-task-error"
           role="alert"
           hidden></p>

        <!-- BUTTONS -->
        <div class="atlas-task-footer">

            <button type="button"
                    class="atlas-task-cancel"
                    id="cancelCreateTask">
                Cancel
            </button>

            <button type="submit"
                    class="atlas-task-create"
                    disabled="@(projects.Count == 0)">
                Create Task
            </button>

        </div>

    </form>

</dialog>

<style>
    /* App #1 - Create Task Modal */

    #createTaskDialog {
        width: min(850px, 95vw);
        max-height: 90vh;
        box-sizing: border-box;
        padding: 30px;
        border: none;
        border-radius: 20px;
        background: white;
        color: #172033;
        font-family: Inter, Arial, sans-serif;
        overflow-y: auto;
        box-shadow: 0 20px 60px rgba(0,0,0,.25);
    }

    #createTaskDialog::backdrop {
        background: rgba(0,0,0,.55);
    }

    .atlas-task-header {
        margin-bottom: 24px;
    }

    .atlas-task-header h2 {
        margin: 0 0 8px;
        font-size: 25px;
        font-weight: 750;
    }

    .atlas-task-header p {
        margin: 0;
        color: #8491a5;
        font-size: 13px;
    }

    .atlas-task-grid {
        display: grid;
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
        gap: 28px;
    }

    .atlas-task-column {
        display: flex;
        flex-direction: column;
        gap: 20px;
        min-width: 0;
    }

    .atlas-task-field {
        display: flex;
        flex-direction: column;
        gap: 8px;
        min-width: 0;
    }

    .atlas-task-field > label,
    .atlas-task-priority legend {
        font-size: 13px;
        font-weight: 600;
        color: #273244;
    }

    .atlas-task-field > input,
    .atlas-task-field > select,
    .atlas-task-field > textarea {
        width: 100%;
        box-sizing: border-box;
        padding: 12px;
        border: 1px solid #d9e1ed;
        border-radius: 8px;
        background: white;
        color: #263449;
        font: inherit;
        font-size: 13px;
    }

    .atlas-task-field textarea {
        resize: vertical;
    }

    .atlas-task-field input:focus,
    .atlas-task-field select:focus,
    .atlas-task-field textarea:focus {
        outline: 2px solid #bfdbfe;
        border-color: #2563eb;
    }

    .atlas-task-field small {
        color: #8491a5;
        font-size: 11px;
        line-height: 1.5;
    }

    .atlas-task-priority {
        border: none;
        padding: 0;
        margin: 0;
        min-width: 0;
    }

    .atlas-task-priority legend {
        margin-bottom: 12px;
    }

    .atlas-priority-options {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
    }

    .atlas-priority-options label {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        cursor: pointer;
    }

    .atlas-priority-options input {
        accent-color: #2563eb;
    }

    .priority-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
    }

    .priority-dot.low {
        background: #16a34a;
    }

    .priority-dot.medium {
        background: #f59e0b;
    }

    .priority-dot.high {
        background: #ef4444;
    }

    .priority-dot.urgent {
        background: #7c3aed;
    }

    .atlas-task-checklist {
        display: flex;
        flex-direction: column;
        gap: 9px;
    }

    .atlas-task-check-item {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 7px 9px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 7px;
        font-size: 12px;
    }

    .atlas-task-check-item label {
        display: flex;
        align-items: center;
        gap: 8px;
        flex: 1;
        min-width: 0;
    }

    .atlas-task-check-item label span {
        overflow-wrap: anywhere;
    }

    .atlas-task-check-item input {
        accent-color: #2563eb;
    }

    .atlas-task-remove {
        border: none;
        background: transparent;
        color: #dc2626;
        font-size: 11px;
        cursor: pointer;
    }

    .atlas-task-add-row {
        display: flex;
        gap: 8px;
    }

    #newSubtask {
        flex: 1;
        min-width: 0;
        padding: 10px;
        border: 1px solid #d9e1ed;
        border-radius: 7px;
        font-size: 12px;
    }

    #addSubtaskButton {
        padding: 9px 12px;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 7px;
        color: #2563eb;
        cursor: pointer;
        font-size: 12px;
    }

    .atlas-task-readonly {
        padding: 12px;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        background: #f8fafc;
        color: #475569;
        font-size: 12px;
    }

    .atlas-task-info {
        padding: 15px;
        border: 1px solid #dbeafe;
        border-radius: 9px;
        background: #eff6ff;
    }

    .atlas-task-info strong {
        font-size: 13px;
        color: #1e40af;
    }

    .atlas-task-info p {
        color: #526582;
        font-size: 12px;
        line-height: 1.6;
        margin: 8px 0 0;
    }

    .atlas-task-footer {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 28px;
        padding-top: 18px;
        border-top: 1px solid #edf0f5;
    }

    .atlas-task-footer button {
        padding: 11px 20px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

    .atlas-task-cancel {
        border: 1px solid #d9e1ed;
        background: white;
        color: #475569;
    }

    .atlas-task-create {
        border: 1px solid #2563eb;
        background: #2563eb;
        color: white;
    }

    .atlas-task-create:disabled {
        opacity: .45;
        cursor: not-allowed;
    }

    .atlas-task-error,
    .atlas-task-warning {
        padding: 12px;
        border-radius: 8px;
        margin: 10px 0;
        color: #b91c1c;
        background: #fef2f2;
        font-size: 12px;
    }

    .atlas-task-error[hidden] {
        display: none;
    }

    .atlas-task-warning a {
        color: #2563eb;
        margin-left: 8px;
    }

    @@media (max-width: 700px) {
        .atlas-task-grid {
            grid-template-columns: 1fr;
        }

        #createTaskDialog {
            padding: 20px;
        }
    }
</style>

<script>
(function () {
    // App #1 - Atlas TaskFlow - Basic Checklist

    const dialog = document.getElementById("createTaskDialog");
    const form = document.getElementById("createTaskForm");
    const list = document.getElementById("atlasChecklistItems");
    const input = document.getElementById("newSubtask");
    const addButton = document.getElementById("addSubtaskButton");
    const description = document.getElementById("taskDescription");
    const error = document.getElementById("taskClientError");
    const cancel = document.getElementById("cancelCreateTask");

    if (!dialog || !form || !list) return;

    function showError(message) {
        error.textContent = message;
        error.hidden = false;
    }

    function addSubtask() {
        const text = input.value.trim();

        if (!text) return;

        if (list.children.length >= 10) {
            showError("Maximum 10 checklist items.");
            return;
        }

        const row = document.createElement("div");
        row.className = "atlas-task-check-item";

        const label = document.createElement("label");

        const checkbox = document.createElement("input");
        checkbox.type = "checkbox";

        const span = document.createElement("span");
        span.textContent = text;

        checkbox.addEventListener("change", function () {
            span.style.textDecoration =
                checkbox.checked ? "line-through" : "none";
        });

        label.append(checkbox, span);

        const remove = document.createElement("button");
        remove.type = "button";
        remove.className = "atlas-task-remove";
        remove.textContent = "Remove";

        remove.addEventListener("click", function () {
            row.remove();
        });

        row.append(label, remove);
        list.appendChild(row);

        input.value = "";
        error.hidden = true;
    }

    addButton.addEventListener("click", addSubtask);

    input.addEventListener("keydown", function (event) {
        if (event.key === "Enter") {
            event.preventDefault();
            addSubtask();
        }
    });

    cancel.addEventListener("click", function () {
        dialog.close();
    });

    // Save checklist lines inside the Description field.
    form.addEventListener("submit", function (event) {
        if (input.value.trim()) {
            addSubtask();
        }

        const rows = Array.from(
            list.querySelectorAll(".atlas-task-check-item")
        );

        const checklist = rows.map(function (row) {
            const checkbox = row.querySelector("input");
            const title = row.querySelector("span").textContent;

            return (checkbox.checked ? "[x] " : "[ ] ") + title;
        });

        let fullDescription = description.value.trim();

        if (checklist.length > 0) {
            fullDescription +=
                (fullDescription ? "\n\n" : "") +
                "Checklist:\n" +
                checklist.join("\n");
        }

        // Description is NVARCHAR(1000) in the existing table.
        if (fullDescription.length > 1000) {
            event.preventDefault();

            showError(
                "Description and checklist must be under 1000 characters."
            );

            return;
        }

        description.value = fullDescription;
    });

    // Reopen the modal after a server-side validation error.
    @if (!string.IsNullOrWhiteSpace(taskError))
    {
        <text>
        if (!dialog.open) {
            dialog.showModal();
        }
        </text>
    }
})();
</script>
