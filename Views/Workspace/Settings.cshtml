
@model Atlas_TaskFlow_App.ViewModels.SettingsPageViewModel

@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Settings";

    string? success = TempData["SettingsSuccess"] as string;
    string? error = TempData["SettingsError"] as string;
}

@section Styles {
    <link rel="stylesheet" href="~/css/workspace.css" />
    <link rel="stylesheet" href="~/css/settings-live.css" />
}

<div class="wf-page">

    <!-- PAGE HEADING -->
    <div class="wf-heading">
        <div>
            <h1>Settings</h1>
            <p>Manage your account, personal profile, and preferences.</p>
        </div>
    </div>

    <!-- SAVE MESSAGES -->
    @if (success != null)
    {
        <div class="settings-live-message settings-success"
             role="status">
            @success
        </div>
    }

    @if (error != null)
    {
        <div class="settings-live-message settings-error"
             role="alert">
            @error
        </div>
    }

    <!-- SETTINGS NAVIGATION -->
    <div class="wf-settings-tabs">

        <button type="button"
                class="active"
                data-settings-tab="profile">
            Profile
        </button>

        <button type="button"
                data-settings-tab="account">
            Account
        </button>

        <button type="button"
                data-settings-tab="notifications">
            Notifications
        </button>

        <button type="button"
                data-settings-tab="appearance">
            Appearance
        </button>

        <button type="button"
                data-settings-tab="privacy">
            Privacy &amp; Security
        </button>

        <button type="button"
                data-settings-tab="integrations">
            Integrations
        </button>

    </div>

    <div class="wf-layout">

        <!-- MAIN CONTENT -->
        <main class="wf-main">

            <!-- ===================================
                 PROFILE - REAL SQL SERVER FORM
                 =================================== -->
            <section class="wf-panel wf-settings-panel"
                     data-settings-panel="profile">

                <div class="wf-panel-heading">
                    <h2>Profile Information</h2>

                    <span class="settings-live-status">
                        Saved in SQL Server
                    </span>
                </div>

                <form method="post"
                      action="@Url.Action("SaveProfile", "Settings")">

                    @Html.AntiForgeryToken()

                    <div class="wf-form-body">

                        <div class="wf-profile">

                            <span class="wf-avatar wf-avatar-large">
                                @(Model.Profile.FullName.Length > 0
                                    ? Model.Profile.FullName.Substring(0, 1).ToUpper()
                                    : "U")
                            </span>

                            <div>
                                <strong>@Model.Profile.FullName</strong>

                                <p>@Model.Email</p>

                                <span class="settings-live-note">
                                    Profile photo upload will be added later.
                                </span>
                            </div>

                        </div>

                        <div class="wf-form-grid">

                            <!-- FULL NAME -->
                            <div class="wf-field">

                                <label for="profileFullName">
                                    Full Name
                                </label>

                                <input id="profileFullName"
                                       name="fullName"
                                       value="@Model.Profile.FullName"
                                       minlength="2"
                                       maxlength="100"
                                       required />

                            </div>

                            <!-- EMAIL - READ ONLY -->
                            <div class="wf-field">

                                <label for="profileEmail">
                                    Email Address
                                </label>

                                <input id="profileEmail"
                                       type="email"
                                       value="@Model.Email"
                                       readonly />

                            </div>

                            <!-- STUDENT ID -->
                            <div class="wf-field">

                                <label for="profileStudentId">
                                    Student ID (Optional)
                                </label>

                                <input id="profileStudentId"
                                       name="studentId"
                                       value="@Model.Profile.StudentId"
                                       maxlength="50" />

                            </div>

                            <!-- UNIVERSITY -->
                            <div class="wf-field">

                                <label for="profileUniversity">
                                    University / Institution
                                </label>

                                <input id="profileUniversity"
                                       name="university"
                                       value="@Model.Profile.University"
                                       maxlength="150" />

                            </div>

                            <!-- MAJOR -->
                            <div class="wf-field">

                                <label for="profileMajor">
                                    Major
                                </label>

                                <input id="profileMajor"
                                       name="major"
                                       value="@Model.Profile.Major"
                                       maxlength="100"
                                       placeholder="Computer Science" />

                            </div>

                            <!-- ACADEMIC YEAR -->
                            <div class="wf-field">

                                <label for="profileYear">
                                    Academic Year
                                </label>

                                <input id="profileYear"
                                       name="academicYear"
                                       value="@Model.Profile.AcademicYear"
                                       maxlength="30"
                                       placeholder="3rd Year" />

                            </div>

                            <!-- GRADUATION -->
                            <div class="wf-field">

                                <label for="profileGraduation">
                                    Expected Graduation
                                </label>

                                <input id="profileGraduation"
                                       name="expectedGraduation"
                                       type="date"
                                       value="@(Model.Profile.ExpectedGraduation?.ToString("yyyy-MM-dd"))" />

                            </div>

                            <!-- TIME ZONE -->
                            <div class="wf-field">

                                <label for="profileTimeZone">
                                    Time Zone
                                </label>

                                <select id="profileTimeZone"
                                        name="timeZone">

                                    <option value="America/New_York"
                                            selected="@(Model.Profile.TimeZone == "America/New_York")">
                                        Eastern Time
                                    </option>

                                    <option value="America/Chicago"
                                            selected="@(Model.Profile.TimeZone == "America/Chicago")">
                                        Central Time
                                    </option>

                                    <option value="America/Denver"
                                            selected="@(Model.Profile.TimeZone == "America/Denver")">
                                        Mountain Time
                                    </option>

                                    <option value="America/Los_Angeles"
                                            selected="@(Model.Profile.TimeZone == "America/Los_Angeles")">
                                        Pacific Time
                                    </option>

                                </select>

                            </div>

                            <!-- BIO -->
                            <div class="wf-field wf-field-wide">

                                <label for="profileBio">
                                    Bio
                                </label>

                                <textarea id="profileBio"
                                          name="bio"
                                          rows="4"
                                          maxlength="500"
                                          placeholder="Tell us about yourself...">@Model.Profile.Bio</textarea>

                            </div>

                        </div>

                        <div class="settings-live-actions">

                            <button type="submit"
                                    class="wf-btn wf-btn-primary">
                                Save Profile
                            </button>

                            <span class="settings-live-note">
                                Only your signed-in profile will be updated.
                            </span>

                        </div>

                    </div>

                </form>

            </section>

            <!-- ===================================
                 ACCOUNT - ASP.NET CORE IDENTITY
                 =================================== -->
            <section class="wf-panel wf-settings-panel"
                     data-settings-panel="account" hidden>

                <div class="wf-panel-heading">
                    <h2>Account Information</h2>
                </div>

                <div class="wf-form-body">

                    <div class="wf-field">
                        <label>Signed-in Email</label>

                        <input type="text"
                               value="@Model.Email"
                               readonly />
                    </div>

                    <div class="settings-live-account-row">

                        <div>
                            <strong>Manage Account</strong>

                            <p>
                                View your ASP.NET Core Identity
                                account details.
                            </p>
                        </div>

                        <a class="wf-btn wf-btn-outline"
                           href="@Url.Page("/Account/Manage/Index", new { area = "Identity" })">
                            Manage
                        </a>

                    </div>

                    <div class="settings-live-account-row">

                        <div>
                            <strong>Change Password</strong>

                            <p>
                                Update your existing account password
                                through Identity.
                            </p>
                        </div>

                        <a class="wf-btn wf-btn-outline"
                           href="@Url.Page("/Account/Manage/ChangePassword", new { area = "Identity" })">
                            Change
                        </a>

                    </div>

                    <div class="settings-live-account-row">

                        <div>
                            <strong>Change Email</strong>

                            <p>
                                Email changes are managed securely
                                by ASP.NET Core Identity.
                            </p>
                        </div>

                        <a class="wf-btn wf-btn-outline"
                           href="@Url.Page("/Account/Manage/Email", new { area = "Identity" })">
                            Manage Email
                        </a>

                    </div>

                </div>

            </section>

            <!-- ===================================
                 NOTIFICATIONS - REAL DATABASE FORM
                 =================================== -->
            <section class="wf-panel wf-settings-panel"
                     data-settings-panel="notifications" hidden>

                <div class="wf-panel-heading">
                    <h2>Notification Preferences</h2>

                    <a href="@Url.Action("Index", "Notifications")">
                        View Notifications
                    </a>
                </div>

                <form method="post"
                      action="@Url.Action("SaveNotifications", "Settings")">

                    @Html.AntiForgeryToken()

                    <div class="wf-form-body">

                        <div class="wf-setting-row">

                            <div>
                                <strong>Email Alerts</strong>
                                <p>Allow future email notification delivery.</p>
                            </div>

                            <input type="checkbox"
                                   name="emailAlerts"
                                   value="true"
                                   checked="@Model.Profile.EmailAlerts" />

                        </div>

                        <div class="wf-setting-row">

                            <div>
                                <strong>Task Reminders</strong>
                                <p>Save your preference for deadline reminders.</p>
                            </div>

                            <input type="checkbox"
                                   name="taskReminders"
                                   value="true"
                                   checked="@Model.Profile.TaskReminders" />

                        </div>

                        <div class="wf-setting-row">

                            <div>
                                <strong>Team Updates</strong>
                                <p>Save your preference for team activity updates.</p>
                            </div>

                            <input type="checkbox"
                                   name="teamUpdates"
                                   value="true"
                                   checked="@Model.Profile.TeamUpdates" />

                        </div>

                        <div class="wf-setting-row">

                            <div>
                                <strong>Weekly Summary</strong>
                                <p>Allow future weekly progress summaries.</p>
                            </div>

                            <input type="checkbox"
                                   name="weeklySummary"
                                   value="true"
                                   checked="@Model.Profile.WeeklySummary" />

                        </div>

                        <p class="settings-live-note">
                            These preferences are saved in SQL Server.
                            Automatic email and push delivery are not
                            implemented yet.
                        </p>

                        <div class="settings-live-actions">
                            <button type="submit"
                                    class="wf-btn wf-btn-primary">
                                Save Preferences
                            </button>
                        </div>

                    </div>

                </form>

            </section>

            <!-- ===================================
                 APPEARANCE - FUTURE FEATURE
                 =================================== -->
            <section class="wf-panel wf-settings-panel"
                     data-settings-panel="appearance" hidden>

                <div class="wf-panel-heading">
                    <h2>Appearance</h2>
                </div>

                <div class="wf-form-body">

                    <div class="wf-field">
                        <label>Current Theme</label>

                        <input value="Light Theme"
                               readonly />
                    </div>

                    <p class="settings-live-note">
                        Dark theme and personal appearance preferences
                        will be implemented in a future phase.
                    </p>

                </div>

            </section>

            <!-- ===================================
                 PRIVACY & SECURITY
                 =================================== -->
            <section class="wf-panel wf-settings-panel"
                     data-settings-panel="privacy" hidden>

                <div class="wf-panel-heading">
                    <h2>Privacy &amp; Security</h2>
                </div>

                <div class="wf-form-body">

                    <div class="settings-live-account-row">

                        <div>
                            <strong>Account Security</strong>

                            <p>
                                Manage the password and security
                                features available in Identity.
                            </p>
                        </div>

                        <a class="wf-btn wf-btn-outline"
                           href="@Url.Page("/Account/Manage/Index", new { area = "Identity" })">
                            Open Identity
                        </a>

                    </div>

                    <div class="settings-live-account-row">

                        <div>
                            <strong>Export My Data</strong>
                            <p>Atlas data export is not implemented yet.</p>
                        </div>

                        <button type="button"
                                class="wf-btn wf-btn-outline"
                                disabled>
                            Coming Soon
                        </button>

                    </div>

                    <div class="settings-live-account-row">

                        <div>
                            <strong>Delete Account</strong>

                            <p>
                                Account deletion and cleanup of Atlas data
                                require additional backend work.
                            </p>
                        </div>

                        <button type="button"
                                class="wf-btn wf-btn-danger"
                                disabled>
                            Not Available
                        </button>

                    </div>

                </div>

            </section>

            <!-- ===================================
                 INTEGRATIONS - FUTURE FEATURE
                 =================================== -->
            <section class="wf-panel wf-settings-panel"
                     data-settings-panel="integrations" hidden>

                <div class="wf-panel-heading">
                    <h2>Integrations</h2>
                </div>

                <div class="wf-form-body">

                    <div class="settings-live-account-row">

                        <div>
                            <strong>Google Calendar</strong>
                            <p>Calendar synchronization is not connected.</p>
                        </div>

                        <button type="button"
                                class="wf-btn wf-btn-outline"
                                disabled>
                            Coming Soon
                        </button>

                    </div>

                    <div class="settings-live-account-row">

                        <div>
                            <strong>Email Integrations</strong>
                            <p>External email providers are not connected.</p>
                        </div>

                        <button type="button"
                                class="wf-btn wf-btn-outline"
                                disabled>
                            Coming Soon
                        </button>

                    </div>

                </div>

            </section>

        </main>

        <!-- RIGHT SIDEBAR -->
        <aside class="wf-side">

            <section class="wf-panel">

                <div class="wf-panel-heading">
                    <h2>Account Overview</h2>
                </div>

                <div class="settings-live-overview">

                    <span class="wf-avatar wf-avatar-large">
                        @(Model.Profile.FullName.Length > 0
                            ? Model.Profile.FullName.Substring(0, 1).ToUpper()
                            : "U")
                    </span>

                    <strong>@Model.Profile.FullName</strong>

                    <small>@Model.Email</small>

                    <p>
                        Profile data is associated with your
                        signed-in Identity account.
                    </p>

                </div>

            </section>

            <section class="wf-panel wf-section-gap">

                <div class="wf-panel-heading">
                    <h2>Quick Actions</h2>
                </div>

                <div class="wf-quick-links">

                    <button type="button"
                            data-settings-go="profile">
                        Edit Profile
                    </button>

                    <button type="button"
                            data-settings-go="notifications">
                        Notification Preferences
                    </button>

                    <button type="button"
                            data-settings-go="account">
                        Account Settings
                    </button>

                    <a href="@Url.Action("Index", "Dashboard")">
                        Back to Dashboard
                    </a>

                </div>

            </section>

            <section class="wf-panel wf-section-gap">

                <div class="wf-panel-heading">
                    <h2>Account Help</h2>
                </div>

                <div class="wf-mini-activity">

                    <p>
                        Account credentials are managed by Identity.
                    </p>

                    <p>
                        Personal profile fields are stored in
                        AtlasTaskFlowDb.
                    </p>

                    <p>
                        Notification delivery preferences are saved,
                        but delivery automation is not active.
                    </p>

                    <p>
                        <a href="@Url.Action("Help", "Workspace")">
                            Open Help Center
                        </a>
                    </p>

                </div>

            </section>

        </aside>

    </div>

</div>

<script src="~/js/workspace.js"></script>
