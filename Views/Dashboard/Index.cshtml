
@* App #1 - Atlas TaskFlow - Dashboard *@
@* Shared task access - Admin and Member *@

@model List<Atlas_TaskFlow_App.Models.TaskItem>
@using Atlas_TaskFlow_App.Models

@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Dashboard";

    bool isAdmin = User.IsInRole("Admin");
    string userName = User.Identity?.Name ?? "User";

    DateTime today = DateTime.Today;
    int daysSinceMonday = ((int)today.DayOfWeek + 6) % 7;
    DateTime monday = today.AddDays(-daysSinceMonday);
    DateTime nextMonday = monday.AddDays(7);

    int totalTasks = Model.Count;

    int overdueTasks = Model.Count(t =>
        t.DueDate.HasValue &&
        t.DueDate.Value.Date < today &&
        t.Status != "Completed");

    int dueThisWeek = Model.Count(t =>
        t.DueDate >= today &&
        t.DueDate < nextMonday &&
        t.Status != "Completed");

    int completedTasks = Model.Count(t =>
        t.Status == "Completed");

    var projects = ViewBag.ProjectList as List<Project>
                   ?? new List<Project>();

    int activeProjects = Convert.ToInt32(
        ViewBag.ActiveProjects ?? 0);

    // Show ACTIVE tasks, including overdue tasks.
    var activeTasks = Model
        .Where(t => t.Status != "Completed")
        .OrderBy(t => t.DueDate)
        .Take(8)
        .ToList();

    DateTime firstDay =
        new DateTime(today.Year, today.Month, 1);

    int daysInMonth =
        DateTime.DaysInMonth(today.Year, today.Month);

    int firstWeekday =
        (int)firstDay.DayOfWeek;

    int calendarCells =
        ((firstWeekday + daysInMonth + 6) / 7) * 7;

    var taskDates = Model
        .Where(t => t.DueDate.HasValue)
        .Select(t => t.DueDate!.Value.Date)
        .ToHashSet();
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" />
}

<div class="dashboard-page">

    <!-- HEADER -->
    <div class="dashboard-heading">

        <div class="heading-text">

            <h1>Welcome back, @userName!</h1>

            <p>
                @(isAdmin
                    ? "Here's an overview of your projects and tasks."
                    : "Here's an overview of your assigned tasks.")
            </p>

        </div>

        <div class="new-task-menu">

            @if (isAdmin)
            {
                @if (projects.Count > 0)
                {
                    <button type="button"
                            class="new-task-button"
                            onclick="document.getElementById('createTaskDialog').showModal()">

                        <svg class="icon" aria-hidden="true">
                            <use href="#i-plus"></use>
                        </svg>

                        <span>New Task</span>
                    </button>
                }
                else
                {
                    <a class="new-task-button"
                       style="text-decoration:none;"
                       href="@Url.Action("Create", "Projects")">

                        <svg class="icon" aria-hidden="true">
                            <use href="#i-plus"></use>
                        </svg>

                        <span>New Project</span>
                    </a>
                }
            }
            else
            {
                <a class="new-task-button"
                   style="text-decoration:none;"
                   href="@Url.Action("Index", "Tasks")">

                    <svg class="icon" aria-hidden="true">
                        <use href="#i-task"></use>
                    </svg>

                    <span>My Assigned Tasks</span>
                </a>
            }

        </div>
    </div>

    <!-- STATISTICS -->
    <section class="stats-grid" aria-label="Task statistics">

        <article class="stat-card">

            <div class="stat-icon stat-blue">
                <svg class="icon" aria-hidden="true">
                    <use href="#i-task"></use>
                </svg>
            </div>

            <div class="stat-information">
                <div class="stat-title">
                    <strong>@totalTasks</strong>
                    <span>Total Tasks</span>
                </div>

                <p>@completedTasks completed tasks</p>
            </div>

        </article>

        <article class="stat-card">

            <div class="stat-icon stat-red">
                <svg class="icon" aria-hidden="true">
                    <use href="#i-alert"></use>
                </svg>
            </div>

            <div class="stat-information">
                <div class="stat-title">
                    <strong>@overdueTasks</strong>
                    <span>Overdue</span>
                </div>

                <p>
                    @(overdueTasks > 0
                        ? "Needs attention"
                        : "No overdue tasks")
                </p>
            </div>

        </article>

        <article class="stat-card">

            <div class="stat-icon stat-orange">
                <svg class="icon" aria-hidden="true">
                    <use href="#i-calendar"></use>
                </svg>
            </div>

            <div class="stat-information">
                <div class="stat-title">
                    <strong>@dueThisWeek</strong>
                    <span>Due This Week</span>
                </div>

                <p>Your upcoming deadlines</p>
            </div>

        </article>

        <article class="stat-card">

            <div class="stat-icon stat-green">
                <svg class="icon" aria-hidden="true">
                    <use href="#i-folder"></use>
                </svg>
            </div>

            <div class="stat-information">
                <div class="stat-title">
                    <strong>@activeProjects</strong>
                    <span>Active Projects</span>
                </div>

                <p>
                    @(isAdmin
                        ? "Your active projects"
                        : "Projects with assigned tasks")
                </p>
            </div>

        </article>

    </section>

    <!-- MAIN DASHBOARD -->
    <div class="dashboard-columns">

        <!-- LEFT SIDE -->
        <div class="dashboard-left">

            <!-- ACTIVE TASKS -->
            <section class="dashboard-panel">

                <div class="panel-heading">

                    <h2>My Active Tasks</h2>

                    <a class="panel-link"
                       href="@Url.Action("Index", "Tasks")">

                        View All

                        <svg class="icon" aria-hidden="true">
                            <use href="#i-arrow"></use>
                        </svg>
                    </a>

                </div>

                <div class="table-scroll">

                    <table class="tasks-table">

                        <thead>
                            <tr>
                                <th aria-label="Selection"></th>
                                <th>Task</th>
                                <th>Project</th>
                                <th>Due Date</th>
                                <th>Priority</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (activeTasks.Count == 0)
                            {
                                <tr>
                                    <td colspan="6"
                                        style="padding:24px;
                                               text-align:center;
                                               color:#64748b;">

                                        No active tasks.

                                        <a href="@Url.Action("Index", "Tasks")">
                                            View My Tasks
                                        </a>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var task in activeTasks)
                                {
                                    bool isOverdue =
                                        task.DueDate.HasValue &&
                                        task.DueDate.Value.Date < today;

                                    <tr>

                                        <td></td>

                                        <td class="task-name">

                                            @if (isAdmin)
                                            {
                                                <a href="@Url.Action("Edit", "Tasks", new { id = task.TaskId })"
                                                   style="color:inherit;
                                                          text-decoration:none;">
                                                    @task.Title
                                                </a>
                                            }
                                            else
                                            {
                                                <a href="@Url.Action("Index", "Tasks")"
                                                   style="color:inherit;
                                                          text-decoration:none;">
                                                    @task.Title
                                                </a>
                                            }

                                        </td>

                                        <td>
                                            @(task.Project?.Name ?? "Unknown")
                                        </td>

                                        <td>
                                            @task.DueDate?.ToString("MMM dd, yyyy")

                                            @if (isOverdue)
                                            {
                                                <small style="color:#dc2626;
                                                              display:block;">
                                                    Overdue
                                                </small>
                                            }
                                        </td>

                                        <td>@task.Priority</td>

                                        <td>@task.Status</td>

                                    </tr>
                                }
                            }

                        </tbody>
                    </table>

                </div>
            </section>

            <!-- RECENT ACTIVITY -->
            <section class="dashboard-panel activity-panel">

                <div class="panel-heading">
                    <h2>Recent Activity</h2>
                </div>

                <div class="activity-list">

                    <div class="activity-item">

                        <span class="activity-icon activity-blue">
                            <svg class="icon" aria-hidden="true">
                                <use href="#i-check-circle"></use>
                            </svg>
                        </span>

                        <p>
                            Activity history is not available yet.
                            Your current tasks are loaded
                            from SQL Server.
                        </p>

                    </div>

                </div>
            </section>

        </div>

        <!-- RIGHT SIDE -->
        <div class="dashboard-right">

            <!-- CALENDAR PREVIEW -->
            <section class="dashboard-panel calendar-panel">

                <div class="panel-heading">

                    <h2>Calendar Preview</h2>

                    <a class="panel-link"
                       href="@Url.Action("Calendar", "Workspace")">
                        View Full Calendar
                    </a>

                </div>

                <div class="calendar-month">

                    <span aria-hidden="true"></span>

                    <strong>
                        @today.ToString("MMMM yyyy")
                    </strong>

                    <span aria-hidden="true"></span>

                </div>

                <div class="calendar-grid"
                     aria-label="Current month calendar">

                    <span class="weekday">Sun</span>
                    <span class="weekday">Mon</span>
                    <span class="weekday">Tue</span>
                    <span class="weekday">Wed</span>
                    <span class="weekday">Thu</span>
                    <span class="weekday">Fri</span>
                    <span class="weekday">Sat</span>

                    @for (int i = 0; i < calendarCells; i++)
                    {
                        DateTime day = firstDay.AddDays(
                            i - firstWeekday);

                        bool isCurrentMonth =
                            day.Month == today.Month;

                        bool isToday =
                            day.Date == today;

                        bool hasTask =
                            taskDates.Contains(day.Date);

                        string dayClass = "calendar-day";

                        if (!isCurrentMonth)
                        {
                            dayClass += " muted";
                        }

                        if (isToday)
                        {
                            dayClass += " selected";
                        }

                        if (hasTask)
                        {
                            dayClass += " has-event";
                        }

                        <span class="@dayClass"
                              title="@(hasTask
                                  ? "Task deadline: " +
                                    day.ToString("MMM dd, yyyy")
                                  : day.ToString("MMM dd, yyyy"))">

                            @day.Day
                        </span>
                    }

                </div>
            </section>

            <!-- PROJECT PROGRESS -->
            <section class="dashboard-panel progress-panel">

                <div class="panel-heading">

                    <h2>
                        @(isAdmin
                            ? "Project Progress"
                            : "My Progress by Project")
                    </h2>

                    <a class="panel-link"
                       href="@(isAdmin
                           ? Url.Action("Index", "Projects")
                           : Url.Action("Index", "Tasks"))">

                        @(isAdmin
                            ? "View All Projects"
                            : "View My Tasks")
                    </a>

                </div>

                @if (projects.Count == 0)
                {
                    <div style="padding:20px 13px;
                                color:#64748b;
                                font-size:12px;">

                        @if (isAdmin)
                        {
                            <span>No projects yet.</span>

                            <a href="@Url.Action("Create", "Projects")">
                                Create your first project
                            </a>
                        }
                        else
                        {
                            <span>
                                No assigned projects yet.
                            </span>
                        }

                    </div>
                }
                else
                {
                    @foreach (var project in projects.Take(4))
                    {
                        int projectTaskCount = Model.Count(t =>
                            t.ProjectId == project.ProjectId);

                        int projectCompleted = Model.Count(t =>
                            t.ProjectId == project.ProjectId &&
                            t.Status == "Completed");

                        int percentage = projectTaskCount == 0
                            ? 0
                            : (int)Math.Round(
                                projectCompleted * 100.0 /
                                projectTaskCount);

                        <div class="progress-item">

                            <div class="progress-label">

                                <strong>@project.Name</strong>

                                <span>
                                    @projectCompleted of @projectTaskCount
                                    @(isAdmin ? "tasks" : "assigned tasks")
                                    completed
                                </span>

                            </div>

                            <div class="progress-track">

                                <div class="progress-fill"
                                     style="width:@(percentage)%">
                                </div>

                            </div>

                        </div>
                    }
                }

            </section>

        </div>

    </div>

    <p class="dashboard-demo-note">
        @(isAdmin
            ? "Statistics are calculated from your owned projects."
            : "Statistics are calculated from tasks assigned to you.")
    </p>

</div>
