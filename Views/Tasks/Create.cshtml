@* App #1 - Atlas TaskFlow - Create Task View *@

@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Create Task";
}

@section Styles {
    <link rel="stylesheet"
          href="@Url.Content("~/css/dashboard.css")">
}

<div class="dashboard-page">

    <div class="dashboard-heading">
        <div class="heading-text">
            <h1>Create New Task</h1>
            <p>Add a new task to Atlas TaskFlow.</p>
        </div>
    </div>

    <section class="dashboard-panel">

        <div class="panel-heading">
            <h2>Task Details</h2>
        </div>

        <p>
            Here we will add our task form.
        </p>

    </section>

</div>
