
@model Atlas_TaskFlow_App.ViewModels.TeamTasksPageViewModel

@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Team Tasks";

    string? message = TempData["TeamMessage"] as string;
    string? error = TempData["TeamError"] as string;

    int totalTasks = Model.AllTasks.Count;

    int assignedTasks = Model.AllTasks.Count(
        t => t.MemberId.HasValue
    );

    int completedTasks = Model.AllTasks.Count(
        t => t.Status == "Completed"
    );

    int unassignedTasks = totalTasks - assignedTasks;
}

@section Styles {
    <link rel="stylesheet" href="~/css/workspace.css" />
    <link rel="stylesheet" href="~/css/team-tasks-live.css" />
}

<div class="wf-page">

    <!-- HEADER -->
    <div class="wf-heading">

        <div>
            <h1>Team Tasks</h1>
            <p>
                Assign tasks, manage team members,
                and track real project progress.
            </p>
        </div>

        <div class="wf-actions">

            <a class="wf-btn wf-btn-primary"
               href="@Url.Action("Index", "Tasks")">
                + New Task
            </a>

            <a class="wf-btn wf-btn-outline"
               href="#addTeamMember">
                + Add Member
            </a>

        </div>
    </div>

    <!-- MESSAGES -->
    @if (message != null)
    {
        <div class="team-alert team-success" role="status">
            @message
        </div>
    }

    @if (error != null)
    {
        <div class="team-alert team-error" role="alert">
            @error
        </div>
    }

    <!-- LIVE STATISTICS -->
    <div class="wf-stats-four">

        <div class="wf-stat-card">
            <span>Total Tasks</span>
            <strong>@totalTasks</strong>
            <small>From SQL Server</small>
        </div>

        <div class="wf-stat-card">
            <span>Assigned Tasks</span>
            <strong>@assignedTasks</strong>
            <small>Linked to a team member</small>
        </div>

        <div class="wf-stat-card">
            <span>Unassigned Tasks</span>
            <strong>@unassignedTasks</strong>
            <small>Need an owner</small>
        </div>

        <div class="wf-stat-card">
            <span>Completed Tasks</span>
            <strong>@completedTasks</strong>
            <small>Marked completed</small>
        </div>

    </div>

    <!-- FILTERS -->
    <section class="wf-panel wf-filter-panel">

        <form method="get"
              action="@Url.Action("TeamTasks", "Workspace")">

            <div class="wf-filter-row">

                <input type="search"
                       class="wf-input wf-search"
                       name="search"
                       value="@Model.Search"
                       placeholder="Search tasks..." />

                <select name="projectId" class="wf-select">

                    <option value="">All Projects</option>

                    @foreach (var project in Model.Projects)
                    {
                        <option value="@project.ProjectId"
                                selected="@(Model.ProjectId == project.ProjectId)">
                            @project.Name
                        </option>
                    }

                </select>

                <select name="memberId" class="wf-select">

                    <option value="">All Members</option>

                    <option value="0"
                            selected="@(Model.MemberId == 0)">
                        Unassigned
                    </option>

                    @foreach (var member in Model.Members)
                    {
                        <option value="@member.MemberId"
                                selected="@(Model.MemberId == member.MemberId)">
                            @member.FullName
                        </option>
                    }

                </select>

                <select name="priority" class="wf-select">

                    <option value="">All Priorities</option>

                    @foreach (var priority in Model.Priorities)
                    {
                        <option value="@priority"
                                selected="@(Model.Priority == priority)">
                            @priority
                        </option>
                    }

                </select>

                <select name="status" class="wf-select">

                    <option value="">All Statuses</option>

                    @foreach (var status in Model.Statuses)
                    {
                        <option value="@status"
                                selected="@(Model.Status == status)">
                            @status
                        </option>
                    }

                </select>

                <button class="wf-btn wf-btn-primary"
                        type="submit">
                    Apply
                </button>

                <a class="wf-btn wf-btn-outline"
                   href="@Url.Action("TeamTasks", "Workspace")">
                    Clear
                </a>

            </div>

        </form>

    </section>

    <div class="wf-layout">

        <!-- MAIN CONTENT -->
        <main class="wf-main">

            <!-- TASK TABLE -->
            <section class="wf-panel">

                <div class="wf-panel-heading">

                    <h2>Team Task List</h2>

                    <span class="team-result-count">
                        @Model.Tasks.Count of @totalTasks tasks
                    </span>

                </div>

                <div class="wf-table-scroll">

                    <table class="wf-table team-live-table">

                        <thead>
                            <tr>
                                <th>Task</th>
                                <th>Project</th>
                                <th>Due Date</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th>Assigned To</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var task in Model.Tasks)
                            {
                                <tr>

                                    <!-- TASK -->
                                    <td>
                                        <a class="team-task-title"
                                           href="@Url.Action("Edit", "Tasks",
                                               new { id = task.TaskId })">
                                            @task.Title
                                        </a>

                                        <small class="team-task-id">
                                            Task #@task.TaskId
                                        </small>
                                    </td>

                                    <!-- PROJECT -->
                                    <td>@task.ProjectName</td>

                                    <!-- DUE DATE -->
                                    <td>
                                        @(task.DueDate?.ToString("MMM dd, yyyy")
                                            ?? "Not set")
                                    </td>

                                    <!-- PRIORITY -->
                                    <td>
                                        <span class="team-pill
                                            @(task.Priority == "High" ||
                                              task.Priority == "Urgent"
                                                ? "team-priority-high"
                                                : task.Priority == "Medium"
                                                    ? "team-priority-medium"
                                                    : "team-priority-low")">
                                            @task.Priority
                                        </span>
                                    </td>

                                    <!-- STATUS -->
                                    <td>
                                        <span class="team-pill
                                            @(task.Status == "Completed"
                                                ? "team-status-completed"
                                                : "team-status-open")">
                                            @task.Status
                                        </span>
                                    </td>

                                    <!-- ASSIGNED MEMBER -->
                                    <td>
                                        <span class="team-assignee">
                                            @task.AssigneeName
                                        </span>
                                    </td>

                                    <!-- ASSIGNMENT FORM -->
                                    <td>

                                        <form method="post"
                                              class="team-assign-form"
                                              action="@Url.Action("AssignTask", "Workspace")">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="taskId"
                                                   value="@task.TaskId" />

                                            <select name="memberId"
                                                    class="wf-select"
                                                    aria-label="Assign @task.Title">

                                                <option value="0"
                                                        selected="@(!task.MemberId.HasValue)">
                                                    Unassigned
                                                </option>

                                                @foreach (var member in Model.Members)
                                                {
                                                    <option value="@member.MemberId"
                                                            selected="@(task.MemberId == member.MemberId)">
                                                        @member.FullName
                                                    </option>
                                                }

                                            </select>

                                            <button type="submit"
                                                    class="wf-btn wf-btn-primary wf-btn-small">
                                                Save
                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

                @if (Model.Tasks.Count == 0)
                {
                    <div class="wf-empty">

                        <h3>No matching tasks</h3>

                        <p>
                            Try clearing the filters,
                            or create your first task.
                        </p>

                        <a class="wf-btn wf-btn-primary"
                           href="@Url.Action("Index", "Tasks")">
                            Open My Tasks
                        </a>

                    </div>
                }

            </section>

            <!-- REAL PROJECT PROGRESS -->
            <section class="wf-panel wf-section-gap">

                <div class="wf-panel-heading">
                    <h2>Project Progress</h2>

                    <a href="@Url.Action("Index", "Projects")">
                        View Projects
                    </a>
                </div>

                <div class="wf-progress-list">

                    @foreach (var project in Model.Projects)
                    {
                        var projectTasks = Model.AllTasks
                            .Where(t => t.ProjectId == project.ProjectId)
                            .ToList();

                        int taskCount = projectTasks.Count;

                        int doneCount = projectTasks.Count(
                            t => t.Status == "Completed"
                        );

                        int percent = taskCount == 0
                            ? 0
                            : (int)Math.Round(
                                doneCount * 100.0 / taskCount
                            );

                        <label>
                            @project.Name
                            <small>
                                @doneCount / @taskCount tasks
                                (@(percent)%)
                            </small>
                        </label>

                        <div class="wf-progress">
                            <span style="width:@(percent)%"></span>
                        </div>
                    }

                    @if (Model.Projects.Count == 0)
                    {
                        <p class="wf-empty">
                            No projects available.
                        </p>
                    }

                </div>

            </section>

        </main>

        <!-- RIGHT SIDEBAR -->
        <aside class="wf-side">

            <!-- TEAM MEMBERS -->
            <section class="wf-panel">

                <div class="wf-panel-heading">

                    <h2>Team Members (@Model.Members.Count)</h2>

                    <a href="#addTeamMember">
                        Add Member
                    </a>

                </div>

                <div class="wf-members">

                    @foreach (var member in Model.Members)
                    {
                        int memberTaskCount = Model.AllTasks
                            .Count(t => t.MemberId == member.MemberId);

                        <div class="wf-member">

                            <span class="wf-avatar">
                                @(member.FullName.Length > 0
                                    ? member.FullName.Substring(0, 1).ToUpper()
                                    : "?")
                            </span>

                            <div>
                                <strong>@member.FullName</strong>

                                <small>
                                    @member.Role ·
                                    @memberTaskCount task(s)
                                </small>

                                @if (!string.IsNullOrWhiteSpace(member.Email))
                                {
                                    <small>@member.Email</small>
                                }

                            </div>

                            <i class="wf-online"></i>

                        </div>
                    }

                    @if (Model.Members.Count == 0)
                    {
                        <p class="wf-empty">
                            No team members yet.
                        </p>
                    }

                </div>

            </section>

            <!-- ADD MEMBER -->
            <section class="wf-panel wf-section-gap"
                     id="addTeamMember">

                <div class="wf-panel-heading">
                    <h2>Add Team Member</h2>
                </div>

                <form method="post"
                      class="team-add-member-form"
                      action="@Url.Action("CreateMember", "Workspace")">

                    @Html.AntiForgeryToken()

                    <div class="wf-field">

                        <label for="teamFullName">
                            Full Name
                        </label>

                        <input id="teamFullName"
                               name="fullName"
                               maxlength="100"
                               minlength="2"
                               required
                               placeholder="Enter member name" />

                    </div>

                    <div class="wf-field">

                        <label for="teamEmail">
                            Email (Optional)
                        </label>

                        <input id="teamEmail"
                               name="email"
                               type="email"
                               maxlength="256"
                               placeholder="name@example.com" />

                    </div>

                    <div class="wf-field">

                        <label for="teamRole">
                            Team Role (Display Only)
                        </label>

                        <select id="teamRole"
                                name="role">

                            <option value="Member">
                                Member
                            </option>

                            <option value="Lead">
                                Lead
                            </option>

                        </select>

                    </div>

                    <button type="submit"
                            class="wf-btn wf-btn-primary team-full-width">
                        Add Member
                    </button>

                    <p class="team-form-note">
                        This creates a team record.
                        It does not create a login account
                        or send an email invitation.
                    </p>

                </form>

            </section>

            <!-- NAVIGATION -->
            <section class="wf-panel wf-section-gap">

                <div class="wf-panel-heading">
                    <h2>Quick Actions</h2>
                </div>

                <div class="wf-quick-links">

                    <a href="@Url.Action("Index", "Tasks")">
                        Manage My Tasks
                    </a>

                    <a href="@Url.Action("Index", "Projects")">
                        Manage Projects
                    </a>

                    <a href="@Url.Action("Calendar", "Workspace")">
                        View Calendar
                    </a>

                </div>

            </section>

        </aside>

    </div>

</div>
