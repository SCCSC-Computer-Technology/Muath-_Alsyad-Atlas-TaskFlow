
@* App #1 - Atlas TaskFlow - Create Project *@
@model Atlas_TaskFlow_App.Models.Project

@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Create Project";

    string? error = ViewBag.Error as string;
}

@section Styles {
    <link rel="stylesheet" href="~/css/projects.css" />
}

<div class="projects-page">

    <div class="projects-heading">
        <div>
            <h1>Create New Project</h1>
            <p>Add a project to organize your tasks.</p>
        </div>

        <a class="projects-secondary-btn"
           href="@Url.Action("Index", "Projects")">
            Back to Projects
        </a>
    </div>

    <section class="projects-form-card">

        <h2>Project Details</h2>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="projects-message error" role="alert">
                @error
            </div>
        }

        <div asp-validation-summary="All"
             class="projects-validation"></div>

        <form method="post"
              action="@Url.Action("Create", "Projects")">

            @Html.AntiForgeryToken()

            <div class="projects-form-grid">

                <div class="projects-field projects-full">
                    <label for="projectName">Project Name *</label>

                    <input id="projectName"
                           type="text"
                           name="Name"
                           value="@Model.Name"
                           maxlength="150"
                           placeholder="Enter project name"
                           required />
                </div>

                <div class="projects-field projects-full">
                    <label for="projectDescription">Description</label>

                    <textarea id="projectDescription"
                              name="Description"
                              maxlength="500"
                              rows="4"
                              placeholder="What is this project about?">@Model.Description</textarea>
                </div>

                <div class="projects-field">
                    <label for="projectStart">Start Date</label>

                    <input id="projectStart"
                           type="date"
                           name="StartDate"
                           value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="projects-field">
                    <label for="projectDue">Due Date</label>

                    <input id="projectDue"
                           type="date"
                           name="DueDate"
                           value="@(Model.DueDate?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="projects-field projects-full">
                    <label for="projectStatus">Status *</label>

                    <select id="projectStatus"
                            name="Status"
                            required>

                        <option value="Planning"
                                selected="@(Model.Status == "Planning")">
                            Planning
                        </option>

                        <option value="Active"
                                selected="@(Model.Status == "Active")">
                            Active
                        </option>

                        <option value="On Hold"
                                selected="@(Model.Status == "On Hold")">
                            On Hold
                        </option>

                        <option value="Completed"
                                selected="@(Model.Status == "Completed")">
                            Completed
                        </option>

                    </select>
                </div>

            </div>

            <div class="projects-form-actions">

                <a class="projects-secondary-btn"
                   href="@Url.Action("Index", "Projects")">
                    Cancel
                </a>

                <button type="submit"
                        class="projects-primary-btn">
                    Create Project
                </button>

            </div>

        </form>

    </section>

</div>
