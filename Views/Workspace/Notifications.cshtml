
@model List<Atlas_TaskFlow_App.Models.AppNotification>

@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Notifications";

    string filter = ViewBag.Filter as string ?? "all";

    int total = Convert.ToInt32(ViewBag.TotalCount ?? 0);
    int unread = Convert.ToInt32(ViewBag.UnreadCount ?? 0);
    int deadlines = Convert.ToInt32(ViewBag.DeadlineCount ?? 0);
    int assignments = Convert.ToInt32(ViewBag.AssignmentCount ?? 0);
    int completed = Convert.ToInt32(ViewBag.CompletedCount ?? 0);
}

@section Styles {
    <link rel="stylesheet" href="~/css/workspace.css" />

    <style>
        .nt-list {
            display: flex;
            flex-direction: column;
        }

        .nt-row {
            display: flex;
            align-items: flex-start;
            gap: 14px;
            padding: 18px;
            border-bottom: 1px solid #e8edf5;
            background: white;
        }

        .nt-row.unread {
            background: #f3f7ff;
            border-left: 3px solid #2563eb;
        }

        .nt-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            width: 38px;
            height: 38px;
            border-radius: 10px;
            font-size: 19px;
            background: #e8f0ff;
        }

        .nt-body {
            flex: 1;
            min-width: 0;
        }

        .nt-body h3 {
            margin: 0 0 7px;
            color: #1f3351;
            font-size: 13px;
        }

        .nt-body p {
            margin: 0 0 9px;
            color: #687a96;
            font-size: 12px;
            line-height: 1.6;
        }

        .nt-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: center;
            color: #8a98ad;
            font-size: 10px;
        }

        .nt-action {
            display: flex;
            flex-direction: column;
            gap: 8px;
            flex-shrink: 0;
        }

        .nt-action button,
        .nt-action a {
            text-align: center;
            font-size: 11px;
            padding: 8px 12px;
            border-radius: 7px;
            text-decoration: none;
            cursor: pointer;
        }

        .nt-action button {
            background: #2563eb;
            border: 1px solid #2563eb;
            color: white;
        }

        .nt-action a {
            border: 1px solid #dbe4f0;
            color: #4c6181;
            background: white;
        }

        .nt-filter-bar {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            padding: 14px;
            border-bottom: 1px solid #e8edf5;
        }

        .nt-filter-bar .wf-chip {
            text-decoration: none;
        }

        .nt-empty {
            padding: 50px 24px;
            text-align: center;
        }

        .nt-empty h3 {
            color: #1f3351;
            margin-bottom: 8px;
        }

        .nt-empty p {
            color: #8492a8;
            font-size: 12px;
        }

        .nt-summary {
            padding: 18px;
        }

        .nt-summary-item {
            display: flex;
            justify-content: space-between;
            padding: 12px 0;
            border-bottom: 1px solid #eef2f7;
            font-size: 12px;
        }

        .nt-summary-item:last-child {
            border-bottom: none;
        }

        .nt-summary-item strong {
            color: #243a5a;
        }

        .nt-help {
            padding: 16px;
            font-size: 12px;
            line-height: 1.7;
            color: #75849b;
        }

        @@media (max-width: 680px) {
            .nt-row {
                flex-wrap: wrap;
            }

            .nt-action {
                width: 100%;
                flex-direction: row;
            }

            .nt-action form {
                flex: 1;
            }

            .nt-action button {
                width: 100%;
            }
        }
    </style>
}

<div class="wf-page">

    <!-- HEADER -->
    <div class="wf-heading">

        <div>
            <h1>Notifications</h1>
            <p>
                Track real task deadlines, assignments,
                and completed work.
            </p>
        </div>

        <div class="wf-actions">

            <form method="post"
                  action="@Url.Action("MarkAllRead", "Notifications")">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="wf-btn wf-btn-primary"
                        disabled="@(unread == 0)">
                    Mark All Read
                </button>

            </form>

            <a class="wf-btn wf-btn-outline"
               href="@Url.Action("Index", "Notifications")">
                Refresh
            </a>

        </div>
    </div>

    <!-- CURRENT SCOPE -->
    <div class="wf-demo-label">
        Database-backed shared notification feed.
        User-specific delivery will be added with account permissions.
    </div>

    <!-- STATISTICS -->
    <div class="wf-stats-four">

        <div class="wf-stat-card">
            <span>All Notifications</span>
            <strong>@total</strong>
            <small>Saved in SQL Server</small>
        </div>

        <div class="wf-stat-card">
            <span>Unread</span>
            <strong>@unread</strong>
            <small>Require review</small>
        </div>

        <div class="wf-stat-card">
            <span>Deadlines</span>
            <strong>@deadlines</strong>
            <small>Due and overdue tasks</small>
        </div>

        <div class="wf-stat-card">
            <span>Assignments</span>
            <strong>@assignments</strong>
            <small>Team task assignments</small>
        </div>

    </div>

    <div class="wf-layout">

        <!-- MAIN NOTIFICATIONS -->
        <main class="wf-main">

            <section class="wf-panel">

                <div class="wf-panel-heading">
                    <h2>Notification Inbox</h2>

                    <span class="wf-muted">
                        @Model.Count result(s)
                    </span>
                </div>

                <!-- FILTER TABS -->
                <div class="nt-filter-bar">

                    <a class="wf-chip @(filter == "all" ? "active" : "")"
                       href="@Url.Action("Index", "Notifications")">
                        All
                    </a>

                    <a class="wf-chip @(filter == "unread" ? "active" : "")"
                       href="@Url.Action("Index", "Notifications", new { filter = "unread" })">
                        Unread
                    </a>

                    <a class="wf-chip @(filter == "deadline" ? "active" : "")"
                       href="@Url.Action("Index", "Notifications", new { filter = "deadline" })">
                        Deadlines
                    </a>

                    <a class="wf-chip @(filter == "assignment" ? "active" : "")"
                       href="@Url.Action("Index", "Notifications", new { filter = "assignment" })">
                        Assignments
                    </a>

                    <a class="wf-chip @(filter == "completed" ? "active" : "")"
                       href="@Url.Action("Index", "Notifications", new { filter = "completed" })">
                        Completed
                    </a>

                </div>

                <!-- REAL DATABASE RECORDS -->
                <div class="nt-list">

                    @foreach (var notification in Model)
                    {
                        string icon =
                            notification.Type == "deadline" ? "⏰" :
                            notification.Type == "assignment" ? "👤" :
                            "✓";

                        <article class="nt-row @(notification.IsRead ? "" : "unread")">

                            <div class="nt-icon">
                                @icon
                            </div>

                            <div class="nt-body">

                                <h3>@notification.Title</h3>

                                <p>@notification.Message</p>

                                <div class="nt-meta">

                                    <span>
                                        @notification.Type.ToUpperInvariant()
                                    </span>

                                    <span>
                                        Detected:
                                        @notification.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                        UTC
                                    </span>

                                    <span>
                                        @(notification.IsRead ? "Read" : "Unread")
                                    </span>

                                </div>

                            </div>

                            <div class="nt-action">

                                <!-- REAL POST REQUEST -->
                                <form method="post"
                                      action="@Url.Action("SetRead", "Notifications")">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@notification.NotificationId" />

                                    <input type="hidden"
                                           name="isRead"
                                           value="@(notification.IsRead ? "false" : "true")" />

                                    <input type="hidden"
                                           name="filter"
                                           value="@filter" />

                                    <button type="submit">
                                        @(notification.IsRead
                                            ? "Mark Unread"
                                            : "Mark as Read")
                                    </button>

                                </form>

                                <a href="@Url.Action("Index", "Tasks")">
                                    View Tasks
                                </a>

                            </div>

                        </article>
                    }

                </div>

                @if (Model.Count == 0)
                {
                    <div class="nt-empty">

                        <h3>No notifications found</h3>

                        <p>
                            There are no saved notifications
                            matching this filter.
                        </p>

                        <a class="wf-btn wf-btn-primary"
                           href="@Url.Action("Index", "Tasks")">
                            Open My Tasks
                        </a>

                    </div>
                }

            </section>

        </main>

        <!-- RIGHT COLUMN -->
        <aside class="wf-side">

            <!-- SUMMARY -->
            <section class="wf-panel">

                <div class="wf-panel-heading">
                    <h2>Activity Summary</h2>
                </div>

                <div class="nt-summary">

                    <div class="nt-summary-item">
                        <span>Deadline Alerts</span>
                        <strong>@deadlines</strong>
                    </div>

                    <div class="nt-summary-item">
                        <span>Task Assignments</span>
                        <strong>@assignments</strong>
                    </div>

                    <div class="nt-summary-item">
                        <span>Completed Tasks</span>
                        <strong>@completed</strong>
                    </div>

                    <div class="nt-summary-item">
                        <span>Unread Notifications</span>
                        <strong>@unread</strong>
                    </div>

                </div>

            </section>

            <!-- QUICK NAVIGATION -->
            <section class="wf-panel wf-section-gap">

                <div class="wf-panel-heading">
                    <h2>Quick Navigation</h2>
                </div>

                <div class="wf-quick-links">

                    <a href="@Url.Action("Index", "Tasks")">
                        My Tasks
                    </a>

                    <a href="@Url.Action("TeamTasks", "Workspace")">
                        Team Tasks
                    </a>

                    <a href="@Url.Action("Calendar", "Workspace")">
                        Calendar
                    </a>

                    <a href="@Url.Action("Index", "Projects")">
                        Projects
                    </a>

                    <a href="@Url.Action("Settings", "Workspace")">
                        Settings
                    </a>

                </div>

            </section>

            <!-- EXPLANATION -->
            <section class="wf-panel wf-section-gap">

                <div class="wf-panel-heading">
                    <h2>How Notifications Work</h2>
                </div>

                <div class="nt-help">

                    <p>
                        Notifications are generated from
                        existing tasks and team assignments
                        when this page is opened.
                    </p>

                    <p>
                        Reading and unread status are
                        saved in SQL Server.
                    </p>

                    <p>
                        This version does not send email
                        or push notifications.
                    </p>

                </div>

            </section>

        </aside>

    </div>

</div>
