
@model List<Atlas_TaskFlow_App.Models.TaskItem>

@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Calendar";

    var projects =
        ViewBag.ProjectList as
        List<Atlas_TaskFlow_App.Models.Project>
        ?? new List<Atlas_TaskFlow_App.Models.Project>();

    int totalTasks = Model.Count;

    int completedTasks = Model.Count(
        t => t.Status == "Completed"
    );

    int unfinishedTasks = totalTasks - completedTasks;
}

@section Styles {
    <link rel="stylesheet"
          href="@Url.Content("~/css/workspace.css")" />
}

<div class="wf-page">

    <!-- HEADER -->
    <div class="wf-heading">
        <div>
            <h1>Calendar</h1>
            <p>View real tasks and deadlines from SQL Server.</p>
        </div>

        <div class="wf-actions">

            <button type="button"
                    class="wf-btn wf-btn-primary"
                    onclick="document.getElementById('createTaskDialog').showModal()">
                + New Task
            </button>

            <button type="button"
                    class="wf-btn wf-btn-outline"
                    disabled
                    title="Separate events will be added later">
                + New Event
            </button>

        </div>
    </div>

    <!-- REAL DATA SUMMARY -->
    <div class="wf-stats-four">

        <div class="wf-stat-card">
            <span>Scheduled Tasks</span>
            <strong>@totalTasks</strong>
            <small>From SQL Server</small>
        </div>

        <div class="wf-stat-card">
            <span>Unfinished Tasks</span>
            <strong>@unfinishedTasks</strong>
            <small>Not completed</small>
        </div>

        <div class="wf-stat-card">
            <span>Completed Tasks</span>
            <strong>@completedTasks</strong>
            <small>Finished work</small>
        </div>

        <div class="wf-stat-card">
            <span>Projects</span>
            <strong>@projects.Count</strong>
            <small>Available projects</small>
        </div>

    </div>

    <!-- DATA RECEIVED FROM RAZOR -->
    <div id="calendarTaskData" hidden>

        @foreach (var task in Model)
        {
            <span data-calendar-task
                  data-id="@task.TaskId"
                  data-date="@(task.DueDate?.ToString("yyyy-MM-dd"))"
                  data-project="@(task.Project?.Name ?? "Unknown")"
                  data-priority="@task.Priority"
                  data-status="@task.Status"
                  data-edit-url="@Url.Action("Edit", "Tasks", new { id = task.TaskId })">
                @task.Title
            </span>
        }

    </div>

    <div class="wf-layout">

        <!-- MAIN CALENDAR -->
        <div class="wf-main">

            <section class="wf-panel">

                <!-- CALENDAR TOOLBAR -->
                <div class="wf-calendar-toolbar">

                    <div class="wf-calendar-month-controls">

                        <button type="button"
                                data-calendar-shift="-1"
                                aria-label="Previous month">
                            ‹
                        </button>

                        <button type="button"
                                data-calendar-today>
                            Today
                        </button>

                        <button type="button"
                                data-calendar-shift="1"
                                aria-label="Next month">
                            ›
                        </button>

                        <strong id="calendarMonthLabel">
                            Calendar
                        </strong>

                    </div>

                    <!-- VIEW OPTIONS -->
                    <div class="wf-view-switch">

                        <button type="button"
                                class="active"
                                data-calendar-view-btn="month">
                            Month
                        </button>

                        <button type="button"
                                data-calendar-view-btn="week">
                            Week
                        </button>

                        <button type="button"
                                data-calendar-view-btn="day">
                            Day
                        </button>

                        <button type="button"
                                data-calendar-view-btn="list">
                            List
                        </button>

                    </div>

                </div>

                <!-- MONTH VIEW -->
                <div data-calendar-panel="month">

                    <div class="wf-weekdays">
                        <span>Sun</span>
                        <span>Mon</span>
                        <span>Tue</span>
                        <span>Wed</span>
                        <span>Thu</span>
                        <span>Fri</span>
                        <span>Sat</span>
                    </div>

                    <div id="calendarGrid"
                         class="wf-calendar-grid">
                    </div>

                </div>

                <!-- WEEK VIEW -->
                <div data-calendar-panel="week" hidden>

                    <div class="wf-alternate-calendar">

                        <h3 id="calendarWeekLabel">
                            This Week
                        </h3>

                        <div id="calendarWeekContent"></div>

                    </div>

                </div>

                <!-- DAY VIEW -->
                <div data-calendar-panel="day" hidden>

                    <div class="wf-alternate-calendar">

                        <h3 id="calendarDayLabel">
                            Selected Day
                        </h3>

                        <div id="calendarDayContent"></div>

                    </div>

                </div>

                <!-- LIST VIEW -->
                <div data-calendar-panel="list" hidden>

                    <div class="wf-alternate-calendar">

                        <h3>All Scheduled Tasks</h3>

                        <div id="calendarListContent"></div>

                    </div>

                </div>

            </section>

            <!-- PAGE FOOTER -->
            <section class="wf-panel wf-section-gap">

                <div class="wf-panel-heading">
                    <h2>Manage Scheduled Tasks</h2>

                    <a href="@Url.Action("Index", "Tasks")">
                        View All Tasks
                    </a>
                </div>

                <div class="wf-mini-activity">

                    <p>
                        Create or edit tasks in My Tasks.
                        Their due dates will appear here.
                    </p>

                    <p>
                        Changes appear after refreshing Calendar.
                    </p>

                </div>

            </section>

        </div>

        <!-- RIGHT SIDEBAR -->
        <aside class="wf-side">

            <!-- UPCOMING TASKS -->
            <section class="wf-panel">

                <div class="wf-panel-heading">
                    <h2>Upcoming Tasks</h2>

                    <a href="@Url.Action("Index", "Tasks")">
                        View All
                    </a>
                </div>

                <div id="calendarUpcoming"
                     class="wf-event-list">
                </div>

            </section>

            <!-- REAL FILTERS -->
            <section class="wf-panel wf-section-gap">

                <div class="wf-panel-heading">
                    <h2>Calendar Filters</h2>
                </div>

                <div class="wf-settings-list">

                    <label for="calendarProjectFilter">
                        Project
                    </label>

                    <select id="calendarProjectFilter"
                            class="wf-select">

                        <option value="">All Projects</option>

                        @foreach (var project in projects)
                        {
                            <option value="@project.Name">
                                @project.Name
                            </option>
                        }

                    </select>

                    <label for="calendarStatusFilter">
                        Status
                    </label>

                    <select id="calendarStatusFilter"
                            class="wf-select">

                        <option value="">All Statuses</option>
                        <option value="To Do">To Do</option>
                        <option value="In Progress">In Progress</option>
                        <option value="Completed">Completed</option>

                    </select>

                </div>

                <div class="wf-divider"></div>

                <a class="wf-btn wf-btn-outline wf-full-button"
                   href="@Url.Action("Index", "Projects")">
                    View Projects
                </a>

                <a class="wf-btn wf-btn-outline wf-full-button"
                   href="@Url.Action("Index", "Tasks")">
                    View My Tasks
                </a>

            </section>

        </aside>

    </div>

</div>

<script src="@Url.Content("~/js/calendar-live.js")"></script>
