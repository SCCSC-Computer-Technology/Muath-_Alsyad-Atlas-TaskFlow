
@* App #1 - Atlas TaskFlow - Edit Project *@

@model Atlas_TaskFlow_App.Models.Project

@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Edit Project";

    string? error = ViewBag.Error as string;
}

@section Styles {
    <link rel="stylesheet" href="~/css/projects.css" />
}

<div class="projects-page">

    <div class="projects-heading">
        <div>
            <h1>Edit Project</h1>
            <p>Update project information and deadlines.</p>
        </div>

        <a href="@Url.Action("Index", "Projects")"
           class="projects-secondary-btn">
            Back to Projects
        </a>
    </div>

    <section class="projects-form-card">

        <h2>Project Details</h2>

        @if (error != null)
        {
            <div class="projects-message error">
                @error
            </div>
        }

        <div asp-validation-summary="All"
             class="projects-validation"></div>

        <form method="post"
              action="@Url.Action("Edit", "Projects", new { id = Model.ProjectId })">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="ProjectId"
                   value="@Model.ProjectId" />

            <div class="projects-form-grid">

                <div class="projects-field projects-full">

                    <label for="projectName">
                        Project Name *
                    </label>

                    <input type="text"
                           id="projectName"
                           name="Name"
                           value="@Model.Name"
                           maxlength="150"
                           required />

                </div>

                <div class="projects-field projects-full">

                    <label for="projectDescription">
                        Description
                    </label>

                    <textarea id="projectDescription"
                              name="Description"
                              maxlength="500"
                              rows="4">@Model.Description</textarea>

                </div>

                <div class="projects-field">

                    <label for="projectStart">
                        Start Date
                    </label>

                    <input type="date"
                           id="projectStart"
                           name="StartDate"
                           value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />

                </div>

                <div class="projects-field">

                    <label for="projectDue">
                        Due Date
                    </label>

                    <input type="date"
                           id="projectDue"
                           name="DueDate"
                           value="@(Model.DueDate?.ToString("yyyy-MM-dd"))" />

                </div>

                <div class="projects-field projects-full">

                    <label for="projectStatus">
                        Status *
                    </label>

                    <select id="projectStatus"
                            name="Status"
                            required>

                        <option value="Planning"
                                selected="@(Model.Status == "Planning")">
                            Planning
                        </option>

                        <option value="Active"
                                selected="@(Model.Status == "Active")">
                            Active
                        </option>

                        <option value="On Hold"
                                selected="@(Model.Status == "On Hold")">
                            On Hold
                        </option>

                        <option value="Completed"
                                selected="@(Model.Status == "Completed")">
                            Completed
                        </option>

                    </select>

                </div>

            </div>

            <div class="projects-form-actions">

                <a href="@Url.Action("Index", "Projects")"
                   class="projects-secondary-btn">
                    Cancel
                </a>

                <button type="submit"
                        class="projects-primary-btn">
                    Save Changes
                </button>

            </div>

        </form>

    </section>

</div>
