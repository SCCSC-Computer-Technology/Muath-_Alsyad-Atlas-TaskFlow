
@* App #1 - Atlas TaskFlow - Dashboard *@
@* Real user data - ASP.NET Core MVC + SQL Server *@

@model List<Atlas_TaskFlow_App.Models.TaskItem>

@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Dashboard";

    // Current signed-in Identity user
    string userName = User.Identity?.Name ?? "User";

    // Current date and week
    DateTime today = DateTime.Today;

    int daysSinceMonday = ((int)today.DayOfWeek + 6) % 7;
    DateTime monday = today.AddDays(-daysSinceMonday);
    DateTime nextMonday = monday.AddDays(7);

    // Statistics from the current user's tasks
    int totalTasks = Model.Count;

    int overdueTasks = Model.Count(t =>
        t.DueDate.HasValue &&
        t.DueDate.Value.Date < today &&
        t.Status != "Completed");

    int dueThisWeek = Model.Count(t =>
        t.DueDate >= monday &&
        t.DueDate < nextMonday &&
        t.Status != "Completed");

    int completedTasks = Model.Count(t =>
        t.Status == "Completed");

    // These projects are filtered by DashboardController
    var projects = ViewBag.ProjectList as
        List<Atlas_TaskFlow_App.Models.Project>
        ?? new List<Atlas_TaskFlow_App.Models.Project>();

    int activeProjects = ViewBag.ActiveProjects == null
        ? 0
        : (int)ViewBag.ActiveProjects;

    // Only unfinished upcoming tasks
    var upcomingTasks = Model
        .Where(t =>
            t.DueDate.HasValue &&
            t.DueDate.Value.Date >= today &&
            t.Status != "Completed")
        .OrderBy(t => t.DueDate)
        .Take(8)
        .ToList();

    // Calendar for the current month
    DateTime firstDay = new DateTime(today.Year, today.Month, 1);
    int daysInMonth = DateTime.DaysInMonth(today.Year, today.Month);
    int firstWeekday = (int)firstDay.DayOfWeek;
    int calendarCells = ((firstWeekday + daysInMonth + 6) / 7) * 7;

    // Real task deadlines for calendar markers
    var taskDates = Model
        .Where(t => t.DueDate.HasValue)
        .Select(t => t.DueDate!.Value.Date)
        .ToHashSet();
}

@section Styles {
    <link rel="stylesheet"
          href="@Url.Content("~/css/dashboard.css")" />
}

<div class="dashboard-page">

    <!-- DASHBOARD HEADER -->
    <div class="dashboard-heading">

        <div class="heading-text">

            <h1>Welcome back, @userName!</h1>

            <p>
                Here's an overview of your tasks and projects.
            </p>

        </div>

        <div class="new-task-menu">

            @if (projects.Count > 0)
            {
                <!-- Open the existing Create Task Modal -->
                <button type="button"
                        class="new-task-button"
                        onclick="document.getElementById('createTaskDialog').showModal()">

                    <svg class="icon" aria-hidden="true">
                        <use href="#i-plus"></use>
                    </svg>

                    <span>New Task</span>

                </button>
            }
            else
            {
                <!-- A new user must create a project first -->
                <a class="new-task-button"
                   style="text-decoration:none;"
                   href="@Url.Action("Create", "Projects")">

                    <svg class="icon" aria-hidden="true">
                        <use href="#i-plus"></use>
                    </svg>

                    <span>New Project</span>

                </a>
            }

        </div>

    </div>

    <!-- REAL STATISTICS -->
    <section class="stats-grid"
             aria-label="Task statistics">

        <!-- TOTAL TASKS -->
        <article class="stat-card">

            <div class="stat-icon stat-blue">
                <svg class="icon" aria-hidden="true">
                    <use href="#i-task"></use>
                </svg>
            </div>

            <div class="stat-information">

                <div class="stat-title">
                    <strong>@totalTasks</strong>
                    <span>Total Tasks</span>
                </div>

                <p>@dueThisWeek due this week</p>

            </div>

        </article>

        <!-- OVERDUE -->
        <article class="stat-card">

            <div class="stat-icon stat-red">
                <svg class="icon" aria-hidden="true">
                    <use href="#i-alert"></use>
                </svg>
            </div>

            <div class="stat-information">

                <div class="stat-title">
                    <strong>@overdueTasks</strong>
                    <span>Overdue</span>
                </div>

                <p>
                    @(overdueTasks > 0
                        ? "Needs attention"
                        : "No overdue tasks")
                </p>

            </div>

        </article>

        <!-- DUE THIS WEEK -->
        <article class="stat-card">

            <div class="stat-icon stat-orange">
                <svg class="icon" aria-hidden="true">
                    <use href="#i-calendar"></use>
                </svg>
            </div>

            <div class="stat-information">

                <div class="stat-title">
                    <strong>@dueThisWeek</strong>
                    <span>Due This Week</span>
                </div>

                <p>Your upcoming deadlines</p>

            </div>

        </article>

        <!-- ACTIVE PROJECTS -->
        <article class="stat-card">

            <div class="stat-icon stat-green">
                <svg class="icon" aria-hidden="true">
                    <use href="#i-folder"></use>
                </svg>
            </div>

            <div class="stat-information">

                <div class="stat-title">
                    <strong>@activeProjects</strong>
                    <span>Active Projects</span>
                </div>

                <p>Your active projects</p>

            </div>

        </article>

    </section>

    <!-- TWO COLUMN DASHBOARD -->
    <div class="dashboard-columns">

        <!-- LEFT COLUMN -->
        <div class="dashboard-left">

            <!-- UPCOMING TASKS -->
            <section class="dashboard-panel">

                <div class="panel-heading">

                    <h2>My Upcoming Tasks</h2>

                    <a class="panel-link"
                       href="@Url.Action("Index", "Tasks")">

                        View All

                        <svg class="icon" aria-hidden="true">
                            <use href="#i-arrow"></use>
                        </svg>

                    </a>

                </div>

                <div class="table-scroll">

                    <table class="tasks-table">

                        <thead>
                            <tr>
                                <th aria-label="Selection"></th>
                                <th>Task</th>
                                <th>Project</th>
                                <th>Due Date</th>
                                <th>Priority</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (upcomingTasks.Count == 0)
                            {
                                <tr>
                                    <td colspan="6"
                                        style="text-align:center;
                                               padding:22px;
                                               color:#64748b;">

                                        No upcoming tasks.

                                        <a href="@Url.Action("Index", "Tasks")">
                                            View My Tasks
                                        </a>

                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var task in upcomingTasks)
                                {
                                    <tr>

                                        <td></td>

                                        <td class="task-name">

                                            <a href="@Url.Action("Edit", "Tasks", new { id = task.TaskId })"
                                               style="color:inherit;text-decoration:none;">
                                                @task.Title
                                            </a>

                                        </td>

                                        <td>
                                            @(task.Project?.Name ?? "Unknown")
                                        </td>

                                        <td>
                                            @task.DueDate?.ToString("MMM dd, yyyy")
                                        </td>

                                        <td>
                                            @task.Priority
                                        </td>

                                        <td>
                                            @task.Status
                                        </td>

                                    </tr>
                                }
                            }

                        </tbody>

                    </table>

                </div>

            </section>

            <!-- RECENT ACTIVITY -->
            <section class="dashboard-panel activity-panel">

                <div class="panel-heading">
                    <h2>Recent Activity</h2>
                </div>

                <div class="activity-list">

                    <div class="activity-item">

                        <span class="activity-icon activity-blue">
                            <svg class="icon" aria-hidden="true">
                                <use href="#i-check-circle"></use>
                            </svg>
                        </span>

                        <p>
                            Activity history is not available yet.
                            Your current tasks and projects are
                            displayed using your real SQL Server data.
                        </p>

                    </div>

                </div>

            </section>

        </div>

        <!-- RIGHT COLUMN -->
        <div class="dashboard-right">

            <!-- REAL CALENDAR PREVIEW -->
            <section class="dashboard-panel calendar-panel">

                <div class="panel-heading">

                    <h2>Calendar Preview</h2>

                    <a class="panel-link"
                       href="@Url.Action("Calendar", "Workspace")">
                        View Full Calendar
                    </a>

                </div>

                <div class="calendar-month">

                    <span aria-hidden="true"></span>

                    <strong>@today.ToString("MMMM yyyy")</strong>

                    <span aria-hidden="true"></span>

                </div>

                <div class="calendar-grid"
                     aria-label="Current month calendar">

                    <!-- Weekday labels -->
                    <span class="weekday">Sun</span>
                    <span class="weekday">Mon</span>
                    <span class="weekday">Tue</span>
                    <span class="weekday">Wed</span>
                    <span class="weekday">Thu</span>
                    <span class="weekday">Fri</span>
                    <span class="weekday">Sat</span>

                    <!-- Build calendar days -->
                    @for (int i = 0; i < calendarCells; i++)
                    {
                        DateTime day = firstDay.AddDays(i - firstWeekday);

                        bool isCurrentMonth = day.Month == today.Month;
                        bool isToday = day.Date == today;
                        bool hasTask = taskDates.Contains(day.Date);

                        string dayClass = "calendar-day";

                        if (!isCurrentMonth)
                        {
                            dayClass += " muted";
                        }

                        if (isToday)
                        {
                            dayClass += " selected";
                        }

                        if (hasTask)
                        {
                            dayClass += " has-event";
                        }

                        <span class="@dayClass"
                              title="@(hasTask ? "Task deadline: " + day.ToString("MMM dd, yyyy") : day.ToString("MMM dd, yyyy"))">
                            @day.Day
                        </span>
                    }

                </div>

            </section>

            <!-- REAL PROJECT PROGRESS -->
            <section class="dashboard-panel progress-panel">

                <div class="panel-heading">

                    <h2>Project Progress</h2>

                    <a class="panel-link"
                       href="@Url.Action("Index", "Projects")">
                        View All Projects
                    </a>

                </div>

                @if (projects.Count == 0)
                {
                    <div style="padding:20px 13px;
                                color:#64748b;
                                font-size:12px;">

                        No projects yet.

                        <a href="@Url.Action("Create", "Projects")">
                            Create your first project
                        </a>

                    </div>
                }
                else
                {
                    @foreach (var project in projects.Take(4))
                    {
                        // Tasks in this project
                        int projectTaskCount = Model.Count(t =>
                            t.ProjectId == project.ProjectId);

                        // Completed tasks in this project
                        int projectCompleted = Model.Count(t =>
                            t.ProjectId == project.ProjectId &&
                            t.Status == "Completed");

                        // Completion percentage
                        int percentage = projectTaskCount == 0
                            ? 0
                            : (int)Math.Round(
                                projectCompleted * 100.0 / projectTaskCount);

                        <div class="progress-item">

                            <div class="progress-label">

                                <strong>@project.Name</strong>

                                <span>
                                    @projectCompleted of @projectTaskCount tasks completed
                                </span>

                            </div>

                            <div class="progress-track">

                                <div class="progress-fill"
                                     style="width:@(percentage)%;">
                                </div>

                            </div>

                        </div>
                    }
                }

            </section>

        </div>

    </div>

    <p class="dashboard-demo-note">
        Dashboard statistics and project progress
        are calculated from your account's data.
    </p>

</div>
