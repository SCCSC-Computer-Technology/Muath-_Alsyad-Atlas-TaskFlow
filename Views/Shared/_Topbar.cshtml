
@* App #1 - Atlas TaskFlow - Topbar *@
@* Current user and Identity Logout *@

@{
    // Get the name of the signed-in user.
    string userName = User.Identity?.Name ?? "Atlas User";

    // Use the first two letters for the avatar.
    string avatar = userName.Length >= 2
        ? userName.Substring(0, 2).ToUpperInvariant()
        : "AT";
}

<header class="app-topbar">

    <!-- Search -->
    <div class="topbar-search">

        <svg class="icon" aria-hidden="true">
            <use href="#i-search"></use>
        </svg>

        <input type="search"
               placeholder="Search tasks, projects, or teammates..."
               aria-label="Search tasks and projects"
               disabled>

    </div>

    <!-- Right Actions -->
    <div class="topbar-actions">

        <!-- Notifications -->
        <span class="notification-icon"
              title="Notifications"
              aria-label="Notifications">

            <svg class="icon" aria-hidden="true">
                <use href="#i-bell"></use>
            </svg>

            <span class="notification-dot"></span>

        </span>

        <!-- Logged-in user -->
        <div class="user-profile">

            <div class="profile-avatar">
                @avatar
            </div>

            <div class="profile-info">
                <strong>@userName</strong>
                <span>Signed in</span>
            </div>

        </div>

        <!-- Logout using ASP.NET Core Identity -->
        <form method="post"
              asp-area="Identity"
              asp-page="/Account/Logout"
              asp-route-returnUrl="/">

            @Html.AntiForgeryToken()

            <button type="submit"
                    title="Sign out of Atlas TaskFlow"
                    style="padding:8px 12px;
                           border:1px solid #d6dfed;
                           border-radius:8px;
                           background:white;
                           color:#334155;
                           font-weight:600;
                           cursor:pointer;">
                Log Out
            </button>

        </form>

    </div>

</header>
